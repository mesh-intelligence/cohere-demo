vars: {
  d2-config: {
    theme-id: 0
    pad: 10
  }
}

table: "" {
  grid-rows: 5
  grid-columns: 3
  grid-gap: 0
  style: {
    stroke: "#c9ccd1"
    fill: transparent
  }

  c00: Model {
    style: {fill: "#3d4a5c"; font-color: "#ffffff"; stroke: "#3d4a5c"; font-size: 15; bold: true}
    width: 280
  }
  c01: What the model does {
    style: {fill: "#3d4a5c"; font-color: "#ffffff"; stroke: "#3d4a5c"; font-size: 15; bold: true}
    width: 430
  }
  c02: Why it is used at this step {
    style: {fill: "#3d4a5c"; font-color: "#ffffff"; stroke: "#3d4a5c"; font-size: 15; bold: true}
    width: 430
  }
  c10: Embed 4\nembed-v4.0 {
    style: {fill: "#f1eafc"; stroke: "#d5c8ef"; font-size: 15; bold: true; font-color: "#4b2d91"}
    width: 280
  }
  c11: Turns text into embeddings for\nsemantic search, across 100+ languages {
    style: {fill: "#ffffff"; stroke: "#e3e5e8"; font-size: 14}
    width: 430
  }
  c12: Indexes every document at ingest\nand turns the tasking into the query {
    style: {fill: "#ffffff"; stroke: "#e3e5e8"; font-size: 14}
    width: 430
  }
  c20: Rerank 3.5\nrerank-v3.5 {
    style: {fill: "#f1eafc"; stroke: "#d5c8ef"; font-size: 15; bold: true; font-color: "#4b2d91"}
    width: 280
  }
  c21: Scores how relevant each\ndocument is to a query {
    style: {fill: "#ffffff"; stroke: "#e3e5e8"; font-size: 14}
    width: 430
  }
  c22: Orders the retrieved reporting before\nthe brief is written from it {
    style: {fill: "#ffffff"; stroke: "#e3e5e8"; font-size: 14}
    width: 430
  }
  c30: Command A\ncommand-a-03-2025 {
    style: {fill: "#f1eafc"; stroke: "#d5c8ef"; font-size: 15; bold: true; font-color: "#4b2d91"}
    width: 280
  }
  c31: Generates text grounded in supplied\ndocuments, with citations {
    style: {fill: "#ffffff"; stroke: "#e3e5e8"; font-size: 14}
    width: 430
  }
  c32: Writes the brief with citations, picks sources and\nweb queries by tool call, renders /translate {
    style: {fill: "#ffffff"; stroke: "#e3e5e8"; font-size: 14}
    width: 430
  }
  c40: Command R7B\ncommand-r7b-12-2024 {
    style: {fill: "#f1eafc"; stroke: "#d5c8ef"; font-size: 15; bold: true; font-color: "#4b2d91"}
    width: 280
  }
  c41: A lighter, faster Command for\nshort structured answers {
    style: {fill: "#ffffff"; stroke: "#e3e5e8"; font-size: 14}
    width: 430
  }
  c42: The audit judge — scores each sentence\nagainst its chunks, classifies facets {
    style: {fill: "#ffffff"; stroke: "#e3e5e8"; font-size: 14}
    width: 430
  }
}
