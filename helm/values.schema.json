{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "chatbot-mesh values",
  "$comment": "Encodes the deployment-values constraints the applier agent (srd006) relies on helm to enforce, replacing the standard-library provisioner's MeshView.Validate. A helm dry-run against this schema is the applier's validate step.",
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "quantity": {
      "type": [
        "string",
        "number"
      ],
      "minLength": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "tag": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        }
      }
    },
    "agentPorts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "monitor"
      ],
      "properties": {
        "chat": {
          "$ref": "#/definitions/port"
        },
        "query": {
          "$ref": "#/definitions/port"
        },
        "apply": {
          "$ref": "#/definitions/port"
        },
        "intent": {
          "$ref": "#/definitions/port"
        },
        "instance": {
          "$ref": "#/definitions/port"
        },
        "control": {
          "$ref": "#/definitions/port"
        },
        "monitor": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "networkPolicyToggle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "profiles",
    "chatbot",
    "ragUnits",
    "ragServer",
    "chroma",
    "llm",
    "ollama",
    "dolt",
    "collector",
    "ingress",
    "validateProfiles",
    "observer",
    "applier",
    "controlPlane",
    "cohere",
    "osint",
    "exporter",
    "corpusSeed"
  ],
  "properties": {
    "agent-services": {
      "type": "object",
      "description": "Values Helm reserves for the agent-services library dependency; the library reads this chart's own values and declares none of its own."
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mountPath",
        "workMountPath"
      ],
      "properties": {
        "external": {
          "type": "object",
          "description": "Verbatim profiles provisioned outside the release, keyed by ConfigMap group.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configMap", "keys"],
            "properties": {
              "configMap": {"type": "string"},
              "checksum": {"type": "string"},
              "keys": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/.*$"
        },
        "workMountPath": {
          "type": "string",
          "pattern": "^/.*$"
        }
      }
    },
    "chatbot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "uiArchiveConfigMap",
        "uiArchiveChecksum",
        "embeddingModel",
        "resources",
        "ports",
        "retrievalBreadth"
      ],
      "properties": {
        "replicas": {
          "$ref": "#/definitions/replicas"
        },
        "uiArchiveConfigMap": {
          "type": "string"
        },
        "uiArchiveChecksum": {
          "type": "string",
          "pattern": "^(|[a-f0-9]{64})$"
        },
        "embeddingModel": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "ports": {
          "allOf": [
            {
              "$ref": "#/definitions/agentPorts"
            },
            {
              "required": [
                "chat"
              ]
            }
          ]
        },
        "retrievalBreadth": {
          "type": "integer",
          "minimum": 1
        },
        "ui": {
          "type": "object",
          "description": "Interface vocabulary the SPA loads at start (GH-929): display labels per wire level, selector and reliability wording, the form name, and a report template in the intsum-template section schema. Rendered into the ui route's declared static_assets.config; empty keeps the compiled DefTech vocabulary.",
          "additionalProperties": false,
          "properties": {
            "levelLabels": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            },
            "clearanceSelectLabel": {"type": "string"},
            "corpusLevelLabel": {"type": "string"},
            "readerSelectLabel": {"type": "string"},
            "reliabilityFloorLabel": {"type": "string"},
            "reliabilityFloorTitle": {"type": "string"},
            "formName": {"type": "string"},
            "templateVersion": {"type": "string"},
            "template": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "order", "source", "required"],
                "properties": {
                  "id": {"type": "string"},
                  "label": {"type": "string"},
                  "order": {"type": "number"},
                  "source": {"type": "string", "enum": ["composed_markdown", "derived"]},
                  "required": {"type": "boolean"},
                  "derivedFrom": {"type": "string"},
                  "headings": {"type": "array", "items": {"type": "string"}},
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "label"],
                      "properties": {"id": {"type": "string"}, "label": {"type": "string"}}
                    }
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "label"],
                      "properties": {"id": {"type": "string"}, "label": {"type": "string"}}
                    }
                  }
                }
              }
            }
          }
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instruction": {"type": "string"},
            "templateVersion": {"type": "string"},
            "sections": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "summary": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["headings", "label"],
                  "properties": {
                    "headings": {"type": "string"},
                    "label": {"type": "string"}
                  }
                },
                "body": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["headings", "label"],
                  "properties": {
                    "headings": {"type": "string"},
                    "label": {"type": "string"}
                  }
                },
                "gaps": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["headings", "label"],
                  "properties": {
                    "headings": {"type": "string"},
                    "label": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "ragUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "collection",
          "embeddingModel"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
            "not": {
              "enum": [
                "embedding",
                "provisioning-workflow-orchestrator"
              ]
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "collection": {
            "type": "string",
            "minLength": 1
          },
          "embeddingModel": {
            "type": "string",
            "minLength": 1
          },
          "replicas": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "ragServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ports",
        "resources"
      ],
      "properties": {
        "ports": {
          "allOf": [
            {
              "$ref": "#/definitions/agentPorts"
            },
            {
              "required": [
                "query"
              ]
            }
          ]
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "chroma": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "port",
        "storage",
        "resources"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "storage": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalURL",
        "port"
      ],
      "properties": {
        "externalURL": {
          "type": "string",
          "format": "uri"
        },
        "port": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "ollama": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "models",
        "preload",
        "persistence",
        "resources",
        "gpu",
        "nodeSelector",
        "tolerations",
        "topology"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "embedding",
            "chat",
            "tier"
          ],
          "properties": {
            "embedding": {
              "type": "string",
              "minLength": 1
            },
            "chat": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/nonEmptyString"
              }
            },
            "tier": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "preload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "suspend",
            "integrationCacheHostPath"
          ],
          "properties": {
            "suspend": {
              "type": "boolean"
            },
            "integrationCacheHostPath": {
              "type": "string",
              "pattern": "^(|/var/lib/declarative-agents/ollama-cache/[a-f0-9]{64})$"
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "storageClass"
          ],
          "properties": {
            "size": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "Exists",
                  "Equal"
                ]
              },
              "value": {
                "type": "string"
              },
              "effect": {
                "type": "string",
                "enum": [
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ]
              },
              "tolerationSeconds": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "topology": {
          "type": "string",
          "enum": [
            "single",
            "per-model"
          ]
        }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ports",
        "pollInterval",
        "resources",
        "proxy"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ports": {
          "$ref": "#/definitions/agentPorts"
        },
        "pollInterval": {
          "type": "string",
          "description": "Observer poll interval, bounded at ten minutes by the 11m machine command envelope.",
          "pattern": "^(?:(?:[1-9]|[1-9][0-9]|[1-5][0-9]{2})s|(?:[1-9]|10)m)$"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "port",
            "resources"
          ],
          "properties": {
            "image": {
              "$ref": "#/definitions/image"
            },
            "port": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        }
      }
    },
    "applier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "ports",
        "allowApply",
        "networkPolicy",
        "resources",
        "params"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "cliDonor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "tag"
              ],
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:[0-9a-f]{64})?$"
                },
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            }
          }
        },
        "chartArchiveConfigMap": {
          "type": "string"
        },
        "ports": {
          "allOf": [
            {
              "$ref": "#/definitions/agentPorts"
            },
            {
              "required": [
                "apply"
              ]
            }
          ]
        },
        "allowApply": {
          "type": "boolean"
        },
        "networkPolicy": {
          "$ref": "#/definitions/networkPolicyToggle"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nResults",
            "chunkCap",
            "tierDefault",
            "chatModel"
          ],
          "properties": {
            "nResults": {
              "type": "integer",
              "minimum": 1
            },
            "chunkCap": {
              "type": "integer",
              "minimum": 0
            },
            "tierDefault": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "chatModel": {
              "$ref": "#/definitions/nonEmptyString"
            }
          }
        }
      }
    },
    "dolt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "port",
        "metricsPort",
        "storage",
        "rootHost",
        "user",
        "database"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "metricsPort": {
          "$ref": "#/definitions/port"
        },
        "storage": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "rootHost": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "user": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "database": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "implementation",
        "uiArchiveConfigMap",
        "uiArchiveChecksum",
        "image",
        "otlpGRPCPort",
        "otlpHTTPPort",
        "externalOTLPEndpoint",
        "integrationResource"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "implementation": {
          "type": "string",
          "enum": [
            "agent",
            "contrib"
          ]
        },
        "uiArchiveConfigMap": {
          "type": "string"
        },
        "uiArchiveChecksum": {
          "type": "string",
          "pattern": "^(|[a-f0-9]{64})$"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "otlpGRPCPort": {
          "$ref": "#/definitions/port"
        },
        "otlpHTTPPort": {
          "$ref": "#/definitions/port"
        },
        "controlPort": {
          "$ref": "#/definitions/port"
        },
        "monitorPort": {
          "$ref": "#/definitions/port"
        },
        "queryPort": {
          "$ref": "#/definitions/port"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "description": "Durable collector storage contract (srd042 R10/R11). Absent or backend=filesystem keeps the emptyDir NDJSON spool; backend=object wires the application bucket and a persistent WAL.",
          "properties": {
            "backend": {"type": "string", "enum": ["filesystem", "object"]},
            "mode": {"type": "string", "enum": ["durable", "ephemeral"]},
            "walMode": {"type": "string", "enum": ["persistent", "ephemeral"]},
            "walPath": {"type": "string"},
            "walCapacity": {"type": "string"},
            "walStorageClass": {"type": "string"},
            "application": {"type": "string"},
            "namespace": {"type": "string"},
            "bucketURL": {"type": "string"},
            "bucketName": {"type": "string"},
            "endpoint": {"type": "string"},
            "prefix": {"type": "string"},
            "retentionClass": {"type": "string", "minLength": 1},
            "retentionDays": {"type": "integer", "minimum": 0}
          }
        },
        "externalOTLPEndpoint": {
          "type": "string"
        },
        "integrationResource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "module",
            "target",
            "commit",
            "runID"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "module": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "runID": {
              "type": "string"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "host",
        "annotations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[-A-Za-z0-9.]*[A-Za-z0-9])?$"
        },
        "observerHost": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[-A-Za-z0-9.]*[A-Za-z0-9])?$"
        },
        "collectorHost": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[-A-Za-z0-9.]*[A-Za-z0-9])?$"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "expose": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provisioning": {"type": "boolean"},
            "observer": {"type": "boolean"},
            "collector": {"type": "boolean"}
          }
        },
        "gke": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "transportHeaders": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "validateProfiles": {
      "type": "boolean"
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "provisioningWorkflowOrchestrator",
        "creator"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provisioningWorkflowOrchestrator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replicas",
            "ports",
            "networkPolicy",
            "resources"
          ],
          "properties": {
            "replicas": {
              "$ref": "#/definitions/replicas"
            },
            "ports": {
              "allOf": [
                {
                  "$ref": "#/definitions/agentPorts"
                },
                {
                  "required": [
                    "intent"
                  ]
                }
              ]
            },
            "networkPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "ingressController"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ingressController": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "namespaceSelector",
                    "podSelector"
                  ],
                  "properties": {
                    "namespaceSelector": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "matchLabels"
                      ],
                      "properties": {
                        "matchLabels": {
                          "$ref": "#/definitions/stringMap"
                        }
                      }
                    },
                    "podSelector": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "matchLabels"
                      ],
                      "properties": {
                        "matchLabels": {
                          "$ref": "#/definitions/stringMap"
                        }
                      }
                    }
                  }
                }
              }
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "creator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replicas",
            "ports",
            "networkPolicy",
            "resources"
          ],
          "properties": {
            "replicas": {
              "$ref": "#/definitions/replicas"
            },
            "ports": {
              "allOf": [
                {
                  "$ref": "#/definitions/agentPorts"
                },
                {
                  "required": [
                    "instance"
                  ]
                }
              ]
            },
            "networkPolicy": {
              "$ref": "#/definitions/networkPolicyToggle"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            },
            "ingestRagUnit": {
              "type": "string",
              "description": "RAG unit whose Chroma the corpus-ingest child writes into; empty takes the first declared unit."
            },
            "ingestEmbedding": {
              "type": "object",
              "additionalProperties": false,
              "description": "Embedding family the ingest child embeds with; empty follows the release.",
              "properties": {
                "provider": {
                  "enum": ["", "ollama", "cohere"],
                  "description": "Provider library the child's embedder root binds to; empty follows the release."
                },
                "model": {
                  "type": "string"
                }
              }
            },
            "ingestOllamaURL": {
              "type": "string",
              "description": "Ollama the ingest child reaches when it embeds there; empty leaves the loopback default."
            },
            "ingestChatModel": {
              "type": "string",
              "description": "Chat model the ingest child's file-selection word invokes; empty leaves the child's default."
            }
          }
        }
      }
    },
    "cohere": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "baseURL",
        "host",
        "scheme",
        "port",
        "model",
        "embedModel",
        "existingSecret",
        "secretKey",
        "rerankModel",
        "rerankTopN"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "baseURL": {
          "type": "string",
          "pattern": "^https?://"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "embedModel": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "rerankModel": {
          "type": "string",
          "minLength": 1
        },
        "rerankTopN": {
          "type": "integer",
          "minimum": 1
        },
        "classifierModel": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "existingSecret": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "osint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "searchBaseURL",
        "allowedHosts",
        "cascade",
        "port",
        "fixture"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "searchBaseURL": {
          "type": "string"
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cascade": {
          "type": "string",
          "enum": [
            "three_pass",
            "single_fusion"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "image"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "$ref": "#/definitions/image"
            }
          }
        },
        "engine": {
          "type": "string",
          "enum": [
            "fixture",
            "serpapi"
          ]
        },
        "serpapi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            },
            "num": {
              "type": "string",
              "pattern": "^[1-9][0-9]?$"
            }
          }
        }
      }
    },
    "corpusSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicas",
        "image",
        "ports",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "export",
            "control",
            "monitor"
          ],
          "properties": {
            "export": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "control": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "monitor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture": {
          "type": "string",
          "enum": [
            "off",
            "delta",
            "full"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "In-cluster LLM tier requires the model set (MeshView.Validate in-cluster branch: embedding, tier selector, and at least one chat model).",
      "if": {
        "required": [
          "ollama"
        ],
        "properties": {
          "ollama": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ollama": {
            "required": [
              "models"
            ]
          }
        }
      }
    },
    {
      "$comment": "External LLM requires an endpoint (MeshView.Validate not-in-cluster branch: externalURL is required when ollama is disabled).",
      "if": {
        "required": [
          "ollama"
        ],
        "properties": {
          "ollama": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "llm"
        ],
        "properties": {
          "llm": {
            "required": [
              "externalURL"
            ],
            "properties": {
              "externalURL": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "$comment": "An external integration sink requires complete bounded run identity.",
      "if": {
        "required": [
          "collector"
        ],
        "properties": {
          "collector": {
            "required": [
              "externalOTLPEndpoint"
            ],
            "properties": {
              "externalOTLPEndpoint": {
                "minLength": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "collector": {
            "required": [
              "integrationResource"
            ],
            "properties": {
              "integrationResource": {
                "required": [
                  "repository",
                  "module",
                  "target",
                  "commit",
                  "runID"
                ],
                "properties": {
                  "repository": {
                    "minLength": 1
                  },
                  "module": {
                    "minLength": 1
                  },
                  "target": {
                    "minLength": 1
                  },
                  "commit": {
                    "minLength": 1
                  },
                  "runID": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
