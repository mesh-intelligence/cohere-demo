# The ui-kit ships from the GitHub npm registry as @mesh-intelligence/ui-kit
# (declarative-agents srd004 R8.3, srd012 R6). Reading it needs a token with
# read:packages: run `npm login --scope=@mesh-intelligence --auth-type=legacy
# --registry=https://npm.pkg.github.com` once; the token stays in ~/.npmrc.
@mesh-intelligence:registry=https://npm.pkg.github.com
